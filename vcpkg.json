{
  "name": "fxclient",
  "version": "1.0.0",
  "homepage": "https://github.com/spchamp/fxclient",
  "description": "Unofficial C++ API client for the OANDA v20 JSON REST API, using OAT++",
  "license": "MIT",
  "dependencies": [
    {
      "name": "vcpkg-cmake",
      "host": true
    },
    {
      "name": "reflectcpp"
    },
    "boost-asio",
    "boost-logic",
    "boost-mpl",
    "boost-outcome",
    "boost-type-index",
    "boost-logic",
    "frozen"
  ],
  "default-features": [],
  "features": {
    "tests": {
      "description": "Build tests",
      "dependencies": [
        "catch2"
      ]
    },
    "oat": {
      "description": "Build with Oat++",
      "dependencies": [
        "oatpp",
        "oatpp-curl",
        "oatpp-openssl",
        {
          "name": "curl",
          "features": [
            "http2",
            "c-ares",
            "openssl"
          ]
        }
      ]
    },
    "libcpr": {
      "description": "Build with libcpr",
      "dependencies": [
        {
          "name": "cpr",
          "features": [
            "ssl"
          ]
        },
        {
          "name": "curl",
          "features": [
            "http2",
            "c-ares",
            "openssl"
          ]
        }
      ]
    },
    "kwallet": {
      "description": "Build with kf5wallet for API token access",
      "dependencies": [
        "kf5wallet"
      ]
    }
  },
  "builtin-baseline": "817892b0ecbc6af994dd6df999c73faf795adbf2"
}